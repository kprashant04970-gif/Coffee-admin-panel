# ==============================================================================
# Manhattan Coffee Admin Panel — Environment Variables (.env.example)
# Hostinger VPS Self-Hosted Deployment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Self-Hosted PostgreSQL Database Connection String
DATABASE_URL="postgresql://manhattan_user:manhattan_secure_pass@localhost:5432/manhattan_coffee"

# Cryptographic Master JWT Secret (HS256 minimum 32 chars)
JWT_SECRET="manhattan_coffee_vps_master_jwt_secret_2026_prod_key"

# Local VPS Storage Directory
UPLOAD_DIR="/var/www/manhattan/uploads"

# Internal Automation & Cron Secret
CRON_SECRET="internal_super_secure_cron_secret_2026"

# Public Client App URL
NEXT_PUBLIC_APP_URL="https://admin.manhattancoffee.in"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Webhooks & Inter-service Integrity
WEBHOOK_SIGNING_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxx"

# Gemini AI API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Deployment App URL
APP_URL="https://admin.manhattancoffee.in"
